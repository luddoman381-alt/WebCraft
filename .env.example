# Скопируйте в .env и при необходимости измените. Файл .env не коммитится.

# Порт API-сервера при разработке (npm run dev). npm start по умолчанию слушает 5181.
# Порт API при разработке: API_PORT=5190 (npm run dev). Порт npm start: PORT=5181
# Интерфейс: 127.0.0.1 — только локально; 0.0.0.0 — для сервера за reverse-proxy
HOST=127.0.0.1

# Файл базы SQLite и каталог загруженных изображений (относительно корня проекта)
DB_PATH=data/webcraft.db
UPLOAD_DIR=data/uploads

# Заполнить пустую базу демонстрационным контентом при первом запуске (0 — не заполнять)
SEED_DEMO=1

# Срок жизни сессии администратора, дней
SESSION_DAYS=7

# Production: NODE_ENV=production включает Secure-cookie и HSTS (нужен HTTPS)
# NODE_ENV=production
# COOKIE_SECURE=1
# Только если сервер стоит за вашим reverse-proxy (nginx и т.п.)
# TRUST_PROXY=1
# Публичный адрес сайта для проверки Origin, например https://webcraft.kz
# PUBLIC_ORIGIN=https://example.com

# Администратор создаётся командой, а не переменной:  npm run admin:create -- --email you@example.com
